# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# Générer une clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-remplacer

# 1 = cookies envoyés uniquement en HTTPS (à activer en production)
COOKIE_SECURE=0

# 1 = mode debug Flask (développement uniquement, jamais en production)
FLASK_DEBUG=0
